<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net40;net9.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>dptdoom2d-launcher</AssemblyName>
    <RootNamespace>DPTDOOM2D.Launcher</RootNamespace>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>DPT.DOOM 2D Launcher</AssemblyTitle>
    <Product>DPT.DOOM 2D</Product>
    <Company>DartPower Team</Company>
    <Copyright>Copyright (C) DartPower Team.</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\resources\dptdoom2d.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The shared protocol is compiled in rather than referenced as an assembly.

    A project reference puts DPTDOOM2D.Shared.dll next to the exe, and that DLL
    is exactly what went missing from the packaged build: the launcher then threw
    "Could not load file or assembly DPTDOOM2D.Shared" as soon as the server list
    was refreshed. Compiling the same sources in - the way the game already does -
    makes the launcher one exe with nothing beside it.
  -->
  <ItemGroup>
    <Compile Include="..\DPTDOOM2D.Shared\MasterProtocol.cs" Link="Shared\MasterProtocol.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\DataManifest.cs" Link="Shared\DataManifest.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\DataSets.cs" Link="Shared\DataSets.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\MasterSessionInfo.cs" Link="Shared\MasterSessionInfo.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\MasterClient.cs" Link="Shared\MasterClient.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\Branding.cs" Link="Shared\Branding.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\PortablePaths.cs" Link="Shared\PortablePaths.cs" />
  </ItemGroup>

  <!--
    The launcher's interface is real HTML/CSS/JS rendered by the WebBrowser
    control (MSHTML), the same approach DPT.DOOM uses: no extra dependency, and
    the layout lives in files a designer can edit.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\ui.html" />
    <EmbeddedResource Include="Assets\theme.css" />
    <EmbeddedResource Include="Assets\app.js" />
  </ItemGroup>

</Project>
