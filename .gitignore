# Build output
bin/
obj/
dist/

# Local run artefacts (the game writes these under Storage/)
Storage/
Screenshots/
launcher.cfg
*.bmp
*.log
*.user
*.suo

# Editor / IDE
.vs/
.idea/
*.DotSettings.user

# Upstream sources and data, fetched by tools/fetch-data.ps1.
# They are third-party trees (GPLv2 game sources), so they stay out of this
# repository.
refs/

# Node/tool caches some editors drop in
node_modules/

# Windows shell droppings: Explorer writes Thumbs.db into any folder it has
# shown pictures from, and desktop.ini whenever a folder gets a custom icon.
# Both appear the moment someone browses docs/images, and neither is content.
Thumbs.db
ehthumbs.db
desktop.ini
