<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doom2D</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net40</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>Doom2D</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Doom 2D</Product>
    <Description>XNA/FNA port of the 1996 Doom2D engine by Prikol Software</Description>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <!--
      The FNA sources are third-party and carry a few warnings of their own; the
      list is deliberately narrow so our own code still reports everything.
    -->
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!--
      FNA: the XNA 4.0 reimplementation this port runs on (Microsoft Public
      License, see ..\external\fna\LICENSE). The sources are vendored so the
      repository builds without the 1.2 GB TerrariaXDK donor tree.
    -->
    <Compile Include="..\external\fna\Microsoft.Xna.Framework\**\*.cs" Link="FNA\Microsoft.Xna.Framework\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Graphics\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Graphics\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Graphics.PackedVector\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Graphics.PackedVector\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Audio\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Audio\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Media\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Media\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Content\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Content\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Input\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Input\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Input.Touch\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Input.Touch\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Storage\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Storage\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.Design\**\*.cs" Link="FNA\Microsoft.Xna.Framework.Design\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\Microsoft.Xna.Framework.GamerServices\**\*.cs" Link="FNA\Microsoft.Xna.Framework.GamerServices\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\MonoGame.Utilities\**\*.cs" Link="FNA\MonoGame.Utilities\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\ObjCRuntime\**\*.cs" Link="FNA\ObjCRuntime\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\SDL2\**\*.cs" Link="FNA\SDL2\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\external\fna\FAudio.cs" Link="FNA\FAudio.cs" />
    <Compile Include="..\external\fna\Theorafile.cs" Link="FNA\Theorafile.cs" />
    <Compile Include="..\external\fna\CRC32Helper.cs" Link="FNA\CRC32Helper.cs" />
    <Compile Include="..\external\fna\ToStringExtensions.cs" Link="FNA\ToStringExtensions.cs" />
    <Compile Include="..\external\fna\StorageDeviceManager.cs" Link="FNA\StorageDeviceManager.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Compiled stock-effect blobs. FNA's Resources.GetResource() asks for exactly
      "Microsoft.Xna.Framework.Graphics.Effect.Resources.<Name>.fxb", so each one
      needs that logical name; the files themselves already carry the prefix.
    -->
    <EmbeddedResource Include="..\external\fna\Microsoft.Xna.Framework.Graphics.Effect.Resources.AlphaTestEffect.fxb" Link="FNA\Effects\AlphaTestEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.AlphaTestEffect.fxb" />
    <EmbeddedResource Include="..\external\fna\Microsoft.Xna.Framework.Graphics.Effect.Resources.BasicEffect.fxb" Link="FNA\Effects\BasicEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.BasicEffect.fxb" />
    <EmbeddedResource Include="..\external\fna\Microsoft.Xna.Framework.Graphics.Effect.Resources.DualTextureEffect.fxb" Link="FNA\Effects\DualTextureEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.DualTextureEffect.fxb" />
    <EmbeddedResource Include="..\external\fna\Microsoft.Xna.Framework.Graphics.Effect.Resources.EnvironmentMapEffect.fxb" Link="FNA\Effects\EnvironmentMapEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.EnvironmentMapEffect.fxb" />
    <EmbeddedResource Include="..\external\fna\Microsoft.Xna.Framework.Graphics.Effect.Resources.SkinnedEffect.fxb" Link="FNA\Effects\SkinnedEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.SkinnedEffect.fxb" />
    <EmbeddedResource Include="..\external\fna\Microsoft.Xna.Framework.Graphics.Effect.Resources.SpriteEffect.fxb" Link="FNA\Effects\SpriteEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.SpriteEffect.fxb" />
    <EmbeddedResource Include="..\external\fna\Microsoft.Xna.Framework.Graphics.Effect.Resources.YUVToRGBAEffect.fxb" Link="FNA\Effects\YUVToRGBAEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.YUVToRGBAEffect.fxb" />
  </ItemGroup>
  <ItemGroup>
    <!--
      gamma.dat is a C array initialiser; it is parsed at startup instead of
      transcribed. It comes from the upstream sources, so a fresh clone that has
      not run tools/fetch-data.ps1 simply falls back to an identity gamma table
      (see Palette.LoadGammaTable).
    -->
    <EmbeddedResource Include="..\refs\doom2d-rembo\src\gamma.dat" Link="Data\gamma.dat" LogicalName="Doom2D.gamma.dat" Condition="Exists('..\refs\doom2d-rembo\src\gamma.dat')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Doom2D data ships next to the exe. It comes from the upstream sources in
      refs/doom2d-rembo (see tools/fetch-data.ps1 for a fresh checkout).
    -->
    <None Include="..\refs\doom2d-rembo\src\doom2d.wad" Link="Data\doom2d.wad" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\refs\doom2d-rembo\src\doom2d.wad')" />
    <None Include="..\refs\doom2d-rembo\src\default.cfg" Link="Data\default.cfg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\refs\doom2d-rembo\src\default.cfg')" />
    <None Include="..\refs\doom2d-rembo\music\*" Link="Data\Music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\refs\doom2d-rembo\music')" />
  </ItemGroup>
</Project>
