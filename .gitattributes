* text=auto eol=lf

# C# and docs: LF. The project builds on Windows, but git can normalise on
# checkout without any risk since nothing depends on line endings.
*.cs      text eol=lf
*.csproj  text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.ps1     text eol=crlf
*.cfg     text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binaries: never touch.
*.dll     binary
*.exe     binary
*.ico     binary
*.png     binary
*.bmp     binary
*.fxb     binary
*.dat     binary
*.wad     binary
