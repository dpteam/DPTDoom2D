<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net40;net9.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>dptdoom2d-master</AssemblyName>
    <RootNamespace>DPTDOOM2D.Master</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>DPT.DOOM 2D master server</AssemblyTitle>
    <Product>DPT.DOOM 2D</Product>
    <Company>DartPower Team</Company>
    <Copyright>Copyright (C) DartPower Team.</Copyright>
    <Version>1.0.0</Version>
    <InvariantGlobalization Condition="'$(TargetFramework)' == 'net9.0'">true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The protocol is compiled in, not referenced: the master ships as one exe,
    and the packaged build gets no DLL to forget to copy. See the launcher's
    csproj for the failure that taught this.
  -->
  <ItemGroup>
    <Compile Include="..\DPTDOOM2D.Shared\MasterProtocol.cs" Link="Shared\MasterProtocol.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\DataManifest.cs" Link="Shared\DataManifest.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\DataSets.cs" Link="Shared\DataSets.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\MasterSessionInfo.cs" Link="Shared\MasterSessionInfo.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\PortablePaths.cs" Link="Shared\PortablePaths.cs" />
    <Compile Include="..\DPTDOOM2D.Shared\Branding.cs" Link="Shared\Branding.cs" />
  </ItemGroup>

</Project>
